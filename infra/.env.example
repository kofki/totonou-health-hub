# Copy to infra/.env — never commit the real .env

# PostgreSQL
POSTGRES_DB=healthhub
POSTGRES_USER=healthhub
POSTGRES_PASSWORD=healthhub

# Object storage (local fake-gcs-server; swap for real GCS values in prod — see docs/gcp-storage.md)
GCS_BUCKET=healthhub-images
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/gcp-credentials.json   # prod only

# Garmin Connect (your normal account login — used by python-garminconnect)
GARMIN_EMAIL=
GARMIN_PASSWORD=

# VeSync (smart scale)
VESYNC_EMAIL=
VESYNC_PASSWORD=
VESYNC_TIMEZONE=America/New_York
